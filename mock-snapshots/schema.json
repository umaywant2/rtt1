{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTT/1 Snapshot Schema",
  "description": "Validation schema for RTT/1 mock snapshots.",
  "type": "object",

  "properties": {
    "engine": {
      "type": "string",
      "const": "rtt1"
    },

    "version": {
      "type": "string"
    },

    "session": {
      "type": "object",
      "properties": {
        "rtt": { "type": "number", "const": 1 },
        "coherence": { "type": "string" },
        "drift": { "type": "string" },
        "paradox": { "type": "string" }
      },
      "required": ["rtt", "coherence", "drift", "paradox"]
    },

    "clarity_surface": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "stated_elements": { "type": "array", "items": { "type": "string" } },
        "surface_claims": { "type": "array", "items": { "type": "string" } },
        "visible_structure": { "type": "array", "items": { "type": "string" } },
        "surface_vocabulary": { "type": "array", "items": { "type": "string" } },
        "declared_relationships": { "type": "array", "items": { "type": "string" } },
        "surface_tensions": { "type": "array", "items": { "type": "string" } },
        "surface_gaps": { "type": "array", "items": { "type": "string" } },
        "surface_questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "summary",
        "stated_elements",
        "surface_claims",
        "visible_structure",
        "surface_vocabulary",
        "declared_relationships",
        "surface_tensions",
        "surface_gaps",
        "surface_questions"
      ]
    },

    "load_bearing": {
      "type": "object",
      "properties": {
        "candidates": { "type": "array", "items": { "type": "string" } },
        "confirmed": { "type": "array", "items": { "type": "string" } },
        "anchors": { "type": "array", "items": { "type": "string" } },
        "collapse_map": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "relationships": { "type": "array", "items": { "type": "string" } },
        "questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "candidates",
        "confirmed",
        "anchors",
        "collapse_map",
        "relationships",
        "questions"
      ]
    },

    "contradiction_scan": {
      "type": "object",
      "properties": {
        "direct": { "type": "array", "items": { "type": "string" } },
        "implicit": { "type": "array", "items": { "type": "string" } },
        "load_bearing_conflicts": { "type": "array", "items": { "type": "string" } },
        "propagation": { "type": "array", "items": { "type": "string" } },
        "regime": { "type": "array", "items": { "type": "string" } },
        "geometry": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "origin": { "type": "string" },
            "spread": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type", "origin", "spread"]
        },
        "questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "direct",
        "implicit",
        "load_bearing_conflicts",
        "propagation",
        "regime",
        "geometry",
        "questions"
      ]
    },

    "structural_critique": {
      "type": "object",
      "properties": {
        "presence": { "type": "array", "items": { "type": "string" } },
        "absence": { "type": "array", "items": { "type": "string" } },
        "tension": { "type": "array", "items": { "type": "string" } },
        "stability": { "type": "string" },
        "shape": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "anchors": { "type": "array", "items": { "type": "string" } },
            "dependencies": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["type", "anchors", "dependencies"]
        },
        "synthesis": { "type": "string" },
        "questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": [
        "presence",
        "absence",
        "tension",
        "stability",
        "shape",
        "synthesis",
        "questions"
      ]
    },

    "diagnostic_surface": {
      "type": "object",
      "properties": {
        "diagnostic": {
          "type": "object",
          "properties": {
            "summary": { "type": "string" }
          },
          "required": ["summary"]
        }
      },
      "required": ["diagnostic"]
    }
  },

  "additionalProperties": false
}

