{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTT/1 Graph Worker Route Schema",
  "description": "Schema describing the graph-based worker API surface for RTT/1.",
  "type": "object",

  "properties": {
    "route": {
      "type": "string",
      "enum": ["graph-analyze", "graph-report", "meta"],
      "description": "The RTT/1 graph worker route to invoke."
    },

    "payload": {
      "type": "object",
      "description": "Graph payload passed to the worker route.",
      "properties": {
        "graph": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": ["string", "null"] },
                  "payload": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": ["id"]
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" }
                },
                "required": ["from", "to"]
              }
            }
          }
        }
      }
    }
  },

  "required": ["route"],

  "definitions": {
    "AnalysisOutput": {
      "type": "object",
      "description": "Raw analysis output from analyze.js",
      "properties": {
        "clarity_surface": { "type": ["object", "null"] },
        "drift": { "type": ["string", "null"] },
        "coherence": { "type": ["number", "null"] },
        "substrate": {
          "type": ["object", "null"],
          "properties": {
            "summary": { "type": ["string", "null"] },
            "signals": { "type": "array", "items": { "type": "string" } },
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "issues": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "stats": { "type": "object" }
          }
        }
      }
    },

    "ReportOutput": {
      "type": "object",
      "description": "Full RTT/1 report object from report.js",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "module": { "type": "string" },
            "timestamp": { "type": "number" },
            "rtt": { "type": "number" },
            "coherence": { "type": ["number", "null"] },
            "drift": { "type": ["string", "null"] }
          }
        },
        "substrate": {
          "type": "object",
          "properties": {
            "summary": { "type": ["string", "null"] },
            "signals": { "type": "array", "items": { "type": "string" } },
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "issues": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "stats": { "type": "object" }
          }
        },
        "payload": {
          "type": "object",
          "properties": {
            "input": { "type": "object" },
            "analysis": { "$ref": "#/definitions/AnalysisOutput" }
          }
        }
      }
    },

    "GraphAnalysisOutput": {
      "type": "object",
      "description": "Graph-shaped analysis output.",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "analysis": { "$ref": "#/definitions/AnalysisOutput" },
              "report": { "$ref": "#/definitions/ReportOutput" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    },

    "MetaOutput": {
      "type": "object",
      "description": "Metadata returned by graph worker meta route",
      "properties": {
        "rtt": { "type": "number" },
        "module": { "type": "string" },
        "version": { "type": "string" },
        "environment": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "ErrorOutput": {
      "type": "object",
      "description": "Error envelope for unknown routes.",
      "properties": {
        "error": { "type": "string" }
      }
    }
  }
}

