{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTT/1 Client API Route Schema",
  "description": "Canonical schema describing the browser client API surface for RTT/1.",
  "type": "object",

  "properties": {
    "route": {
      "type": "string",
      "enum": ["analyze", "report", "meta"],
      "description": "The RTT/1 client route to invoke."
    },

    "payload": {
      "type": "object",
      "description": "Input payload passed to the client route.",
      "additionalProperties": true
    }
  },

  "required": ["route"],

  "definitions": {
    "AnalysisOutput": {
      "type": "object",
      "description": "Raw analysis output from analyze.js",
      "properties": {
        "clarity_surface": { "type": ["object", "null"] },
        "drift": { "type": ["string", "null"] },
        "coherence": { "type": ["number", "null"] },
        "substrate": {
          "type": ["object", "null"],
          "properties": {
            "summary": { "type": ["string", "null"] },
            "signals": { "type": "array", "items": { "type": "string" } },
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "issues": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "stats": { "type": "object" }
          }
        }
      }
    },

    "ReportOutput": {
      "type": "object",
      "description": "Full RTT/1 report object from report.js",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "module": { "type": "string" },
            "timestamp": { "type": "number" },
            "rtt": { "type": "number" },
            "coherence": { "type": ["number", "null"] },
            "drift": { "type": ["string", "null"] }
          }
        },
        "substrate": {
          "type": "object",
          "properties": {
            "summary": { "type": ["string", "null"] },
            "signals": { "type": "array", "items": { "type": "string" } },
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "issues": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "stats": { "type": "object" }
          }
        },
        "payload": {
          "type": "object",
          "description": "Original input and analysis output.",
          "properties": {
            "input": { "type": "object" },
            "analysis": { "$ref": "#/definitions/AnalysisOutput" }
          }
        }
      }
    },

    "MetaOutput": {
      "type": "object",
      "description": "Metadata returned by clientMeta()",
      "properties": {
        "rtt": { "type": "number" },
        "module": { "type": "string" },
        "version": { "type": "string" },
        "environment": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "ErrorOutput": {
      "type": "object",
      "description": "Error envelope for unknown routes or failures.",
      "properties": {
        "error": { "type": "string" }
      }
    }
  },

  "oneOf": [
    { "$ref": "#/definitions/AnalysisOutput" },
    { "$ref": "#/definitions/ReportOutput" },
    { "$ref": "#/definitions/MetaOutput" },
    { "$ref": "#/definitions/ErrorOutput" }
  ]
}

