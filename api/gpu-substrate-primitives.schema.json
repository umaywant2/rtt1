{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTT/1 GPU Substrate Primitives",
  "version": "2026.1",
  "type": "object",

  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "tier"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "tier": { "type": "string", "enum": ["S", "E", "R"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "weight"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },

  "required": ["nodes", "edges"]
}
